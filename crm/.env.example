# --- Database -----------------------------------------------------------
# Use a NON-superuser role WITHOUT the BYPASSRLS attribute so Row-Level
# Security is always enforced (see drizzle/0001_rls.sql).
DATABASE_URL=postgres://crm_app:password@localhost:5432/crm
# Superuser/owner URL used ONLY by migrations (npm run db:migrate).
DATABASE_ADMIN_URL=postgres://postgres:password@localhost:5432/crm

# --- App ----------------------------------------------------------------
APP_URL=http://localhost:3000
# 32 random bytes, base64 — encrypts WhatsApp tokens & webhook secrets (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Secret required by the background job runner (/api/jobs/run) and cron.
CRON_SECRET=

# --- Meta / WhatsApp Cloud API -----------------------------------------
META_APP_ID=
META_APP_SECRET=
# Embedded Signup v4 configuration id (Facebook Login for Business config).
META_ES_CONFIG_ID=
# Token you choose; configure the same value on the Meta webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Feature flag: Meta Lead Ads connector (requires leads_retrieval approval).
META_LEADGEN_ENABLED=false

# --- Transactional e-mail (Resend) -------------------------------------
RESEND_API_KEY=
EMAIL_FROM="CRM <no-reply@example.com>"
